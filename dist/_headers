# Cloudflare Pages 响应头配置
# 语法参考：https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 静态资源：文件名不带指纹，用 HTML 里的 ?v=YYYYMMDD 做版本号
# ⚠️ 改完 style.css / main.js 必须把各页面 HTML 里的 ?v= 一起更新，
#    否则边缘缓存 30 天内不会失效（新部署也不会自动清），用户会看到旧样式
/assets/*
  Cache-Control: public, max-age=2592000

# HTML 不缓存，保证改了内容用户立刻看到
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 站点地图与 robots 短缓存
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
